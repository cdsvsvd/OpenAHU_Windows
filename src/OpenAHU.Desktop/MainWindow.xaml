<Window x:Class="OpenAHU.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenAHU 本地学习助手"
        Width="1280" Height="820" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="OpenAHU 本地学习助手主窗口">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource DemoBannerBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="OpenAHU" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="本地学习助手" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="本地演示数据，非学校官方信息" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource DemoTextBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="14,18,14,10">
                        <TextBlock Text="功能导航" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,8,8" />
                        <ItemsControl ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource NavigationButtonStyle}"
                                            AutomationProperties.Name="{Binding Title}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Margin="14" Padding="12" Background="{DynamicResource SurfaceBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="服务状态" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding ServiceStatus}" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DatabaseStatus}" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <Button Content="重新连接" Command="{Binding ReconnectCommand}" Style="{StaticResource CompactButtonStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24,20,24,18">
                <ContentControl Content="{Binding CurrentPage.View}" />
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="28" Visibility="{Binding HasPage, Converter={StaticResource InverseBooleanVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                        <TextBlock Text="本地服务暂不可用" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StartupError}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,20" />
                        <Button Content="重新连接本地服务" Command="{Binding ReconnectCommand}" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="18,9">
            <DockPanel>
                <TextBlock Text="{Binding ServiceMessage}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding DataSourceLabel}" Foreground="{DynamicResource MutedTextBrush}" Margin="20,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
