<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="StatusMessage" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#18394A" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,4,10,4" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,4,0,10" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,4,10,10" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E5EBEF" />
        <Setter Property="AlternatingRowBackground" Value="#F5F8FA" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="ColumnHeaderHeight" Value="38" />
        <Setter Property="BorderBrush" Value="#D7E1E7" />
        <Setter Property="MinHeight" Value="120" />
    </Style>
    <DataTemplate x:Key="PageStatus">
        <StackPanel Margin="0,0,0,12">
            <Border Background="#FFF3CF" Padding="12,9" CornerRadius="5">
                <TextBlock Text="本地演示数据，非学校官方信息" Foreground="#694A08" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="刷新" Command="{Binding RefreshCommand}" AutomationProperties.Name="刷新当前页面" />
                <TextBlock Text="正在加载本地数据…" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource StatusMessage}" Foreground="#A12222" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Text="{Binding Notice}" Style="{StaticResource StatusMessage}" Foreground="#245A53" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TermSelector">
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
            <TextBlock Text="学期" VerticalAlignment="Center" Margin="0,0,12,6" />
            <ComboBox Width="290" ItemsSource="{Binding Terms}" SelectedItem="{Binding SelectedTerm}" DisplayMemberPath="Name" AutomationProperties.Name="选择学期" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
