<UserControl x:Class="OpenAHU.Desktop.Features.Timetable.TimetableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenAHU.Desktop.Features.Timetable" FontSize="14" Background="White" Foreground="#202C34">
    <UserControl.Resources><ResourceDictionary Source="/OpenAHU.Desktop.Features;component/Common/FeatureStyles.xaml" /></UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="课表与本地课程维护" Style="{StaticResource PageTitle}" />
        <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource PageStatus}" />
        <StackPanel Grid.Row="2" IsEnabled="{Binding IsIdle}">
            <WrapPanel IsEnabled="{Binding CanChangeFilters}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TermSelector}" />
                <TextBlock Text="周次" VerticalAlignment="Center" Margin="8,0,10,6" />
                <ComboBox Width="75" ItemsSource="{Binding Weeks}" SelectedItem="{Binding SelectedWeek}" AutomationProperties.Name="选择周次" />
                <CheckBox Content="显示全学期课程" IsChecked="{Binding ShowAllWeeks}" VerticalAlignment="Center" Margin="8,0,0,6" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,10">
                <Button Content="新增本地课程" Command="{Binding NewCommand}" />
                <Button Content="编辑选中课程" Command="{Binding EditCommand}" />
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedCourse}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="本地演示课表">
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="星期" Binding="{Binding DayText}" Width="65" />
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="节次" Binding="{Binding Sections}" Width="80" />
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="课程" Binding="{Binding Name}" Width="*" MinWidth="130" />
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="教师" Binding="{Binding Teacher}" Width="95" />
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="地点" Binding="{Binding Location}" Width="110" />
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="上课周次" Binding="{Binding Weeks}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Width="330" Margin="16,0,0,0" Padding="16" BorderBrush="#D7E1E7" BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="保存课程" Command="{Binding SaveCommand}" IsDefault="True" />
                        <Button Content="取消" Command="{Binding CancelEditCommand}" />
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Editor.Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding Editor.Term.Name}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="课程名称（必填）" />
                        <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="课程名称" />
                        <TextBlock Text="教师（可空）" />
                        <TextBox Text="{Binding Editor.Teacher, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="教师" />
                        <TextBlock Text="地点（可空）" />
                        <TextBox Text="{Binding Editor.Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" AutomationProperties.Name="地点" />
                        <TextBlock Text="星期" />
                        <ComboBox ItemsSource="{x:Static local:CourseEditorViewModel.Days}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Editor.Day}" AutomationProperties.Name="上课星期" />
                        <TextBlock Text="开始节次 / 结束节次（1–20）" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Editor.StartSection, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,10" AutomationProperties.Name="开始节次" />
                            <TextBox Grid.Column="1" Text="{Binding Editor.EndSection, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="结束节次" />
                        </Grid>
                        <TextBlock Text="{Binding Editor.WeekHint}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Editor.Weeks, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="上课周次" />
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
