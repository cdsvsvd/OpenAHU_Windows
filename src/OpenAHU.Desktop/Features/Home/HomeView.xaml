<UserControl x:Class="OpenAHU.Desktop.Features.Home.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="14" Background="White" Foreground="#202C34">
    <UserControl.Resources><ResourceDictionary Source="/OpenAHU.Desktop.Features;component/Common/FeatureStyles.xaml" /></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="首页 · 本地学习助手" Style="{StaticResource PageTitle}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageStatus}" />
            <Border BorderBrush="#D7E1E7" BorderThickness="1" Padding="22" CornerRadius="8" Margin="0,6,0,18">
                <StackPanel>
                    <TextBlock Text="虚构本地演示资料" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding Profile.DisplayName, TargetNullValue=尚未加载, FallbackValue=尚未加载}" FontSize="24" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding Profile.Id, StringFormat=演示资料编号：{0}, TargetNullValue=未提供}" Margin="0,5" />
                    <TextBlock Text="{Binding Profile.College, StringFormat=学院：{0}, TargetNullValue=未提供}" Margin="0,5" />
                    <TextBlock Text="{Binding Profile.Major, StringFormat=专业：{0}, TargetNullValue=未提供}" Margin="0,5" />
                    <TextBlock Text="{Binding Profile.GradeYear, StringFormat=年级：{0}, TargetNullValue=未提供}" Margin="0,5" />
                </StackPanel>
            </Border>
            <TextBlock Text="数据状态" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="{Binding Status.Provider, StringFormat=数据来源：{0}, TargetNullValue=尚未加载}" Margin="0,4" />
            <TextBlock Text="{Binding Status.Message}" TextWrapping="Wrap" Margin="0,4" />
            <TextBlock Text="{Binding UpdatedAtText, StringFormat=数据更新时间：{0}}" Margin="0,4" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
