<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    04 号业务单元测试：只测 Application 层的规则，不碰数据库。
    仓储与 IUnitOfWork 用手写假实现（内存 List），因此不需要 EF、不需要 SQLite、不需要实例化真实数据库。
    包版本沿用 05 号已验证通过的组合（见 src/OpenAHU.Infrastructure/Verification/*.csproj），
    避免 CI 因版本不匹配而失败：
      Microsoft.NET.Test.Sdk 18.0.1 / xunit 2.9.3 / xunit.runner.visualstudio 3.1.5
    运行：dotnet test tests/OpenAHU.Application.Tests/OpenAHU.Application.Tests.csproj
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenAHU.Application\OpenAHU.Application.csproj" />
  </ItemGroup>

</Project>
